# Django
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
WEB_CONCURRENCY=2

# Nexo's database (only read from here)
DATABASE_URL=postgresql://user:password@host:5432/nexo?sslmode=require
CONN_MAX_AGE=60

# What the billing server presents to be heard
SERVICE_TOKEN=change-me

# Who may read it from a browser
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=